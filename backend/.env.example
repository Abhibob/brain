# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# Database + Redis
EDUTRACK_DATABASE_URL=sqlite+aiosqlite:///./.verify/edutrack.db
EDUTRACK_REDIS_URL=redis://localhost:6389/0

# LLM provider: auto | openai | openrouter | deterministic
# "auto" picks openai when EDUTRACK_OPENAI_API_KEY is set, then openrouter, else deterministic.
EDUTRACK_LLM_PROVIDER=openai

# Direct OpenAI API (what we use by default)
EDUTRACK_OPENAI_API_KEY=sk-replace-me
EDUTRACK_OPENAI_BASE_URL=https://api.openai.com/v1

# Chat + embedding models (no provider prefix when calling OpenAI directly).
EDUTRACK_LLM_MODEL=gpt-5.4
EDUTRACK_EMBEDDING_MODEL=text-embedding-3-small
EDUTRACK_EMBEDDING_DIM=1536

# Optional: only needed if you want to switch to OpenRouter instead of OpenAI.
# EDUTRACK_OPENROUTER_API_KEY=
# EDUTRACK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: YouTube Data API v3 for video search in the lesson studio.
# Leave unset to use the deterministic fallback set.
# EDUTRACK_YOUTUBE_API_KEY=

# Celery / other
EDUTRACK_CELERY_TASK_ALWAYS_EAGER=1
EDUTRACK_XGBOOST_MIN_SAMPLES=50
EDUTRACK_API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
EDUTRACK_JWT_SECRET=dev-edutrack-change-me
